---
// City / service-area landing template. areaServed = the specific city (not just Little Rock),
// so each page targets that town's local searches. Content per page must be UNIQUE per city.
import Page from '../layouts/Page.astro';

interface Faq { q: string; a: string }
interface Props {
  city: string;
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  h1: string;
  lede: string;
  photo: string;
  photoAlt: string;
  intro: string;         // unique local paragraph(s), html
  localContext: string;  // unique "serving <city>" paragraph(s), html
  faqs: Faq[];
  related: { label: string; href: string }[];
}
const { city, title, description, path, eyebrow, h1, lede, photo, photoAlt, intro, localContext, faqs, related } = Astro.props;

const siteUrl = 'https://westlittlerockglass.com';
const phone = '501-223-3034';
const phoneTel = '+15012233034';

const svc = [
  { label: 'Frameless shower doors', href: '/frameless-shower-doors-little-rock' },
  { label: 'Custom mirrors & antiquing', href: '/custom-mirrors-little-rock' },
  { label: 'Glass handrails & railings', href: '/glass-handrails-little-rock' },
  { label: 'Commercial storefront glass', href: '/storefront-glass-little-rock' },
  { label: '24-hour emergency glass repair', href: '/glass-repair-little-rock' },
];

const serviceLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Custom Glass & Repair in ${city}, AR`,
  serviceType: 'Glass installation and repair',
  areaServed: { '@type': 'City', name: city, containedInPlace: { '@type': 'State', name: 'Arkansas' } },
  provider: {
    '@type': 'LocalBusiness',
    name: 'West Little Rock Glass',
    telephone: phone,
    address: { '@type': 'PostalAddress', streetAddress: '1903 Hinson Loop Rd #3903', addressLocality: 'Little Rock', addressRegion: 'AR', postalCode: '72212' },
    aggregateRating: { '@type': 'AggregateRating', ratingValue: 3.9, reviewCount: 38, bestRating: 5 },
  },
  url: `${siteUrl}${path}`,
});
const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: `Glass in ${city}`, item: `${siteUrl}${path}` },
  ],
});
---

<Page title={title} description={description} path={path} ldBlocks={[serviceLd, faqLd, breadcrumbLd]}>
  <header class="lp-hero">
    <div class="container">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
        <a class="btn btn-light" href="#quote">Get a Free Quote</a>
      </div>
    </div>
  </header>

  <section class="lp-section">
    <div class="container lp-grid">
      <div class="lp-body">
        <h2>Glass done right in {city}</h2>
        <Fragment set:html={intro} />
      </div>
      <div class="lp-photo">
        <img src={photo} alt={photoAlt} width="900" height="640" loading="eager" />
      </div>
    </div>
  </section>

  <section class="lp-section alt">
    <div class="container">
      <div class="lp-body" style="max-width:72ch">
        <h2>What we install &amp; repair in {city}</h2>
        <p>The same crew, tools, and 20+ years of experience we bring across the Little Rock metro — now at your {city} address. Every job is quoted, cut, and installed by the same people.</p>
        <ul>
          {svc.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="lp-section">
    <div class="container">
      <div class="lp-body" style="max-width:72ch">
        <h2>Serving {city} and the surrounding area</h2>
        <Fragment set:html={localContext} />
      </div>
    </div>
  </section>

  <section class="lp-section alt">
    <div class="container lp-grid" style="align-items:start">
      <div class="lp-faq">
        <h2>{city} glass questions</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <form id="quote" class="quote-form" name="quote" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <h3>Free {city} quote</h3>
        <p>Tell us about your project. We respond within one business day.</p>
        <input type="hidden" name="form-name" value="quote" />
        <input type="hidden" name="page" value={path} />
        <p class="honeypot"><label>Don't fill this out: <input name="bot-field" /></label></p>
        <div class="form-row">
          <label>Name<input type="text" name="name" required autocomplete="name" /></label>
          <label>Phone<input type="tel" name="phone" required autocomplete="tel" /></label>
        </div>
        <div class="form-row">
          <label>Email<input type="email" name="email" autocomplete="email" /></label>
          <label>City<input type="text" name="service" value={city} /></label>
        </div>
        <label>Details<textarea name="message" rows="4" placeholder="Measurements, timing, anything else…"></textarea></label>
        <button class="btn btn-primary" type="submit">Send Quote Request</button>
      </form>
    </div>
  </section>

  <section class="lp-cta">
    <div class="container">
      <h2>{city}, let&rsquo;s talk glass.</h2>
      <p>West Little Rock Glass — 20+ years, family-run, and just a short drive from {city}. Free estimates, real numbers, no subcontractors.</p>
      <div class="ctas">
        <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
        <a class="btn btn-ghost" style="color:var(--white);border-color:rgba(255,255,255,0.4)" href="/#services">All Services</a>
      </div>
    </div>
  </section>

  <div class="container">
    <nav class="lp-related" aria-label="Related areas and services">
      <span>Also serving:</span>
      {related.map((r) => <a href={r.href}>{r.label}</a>)}
    </nav>
  </div>
</Page>
