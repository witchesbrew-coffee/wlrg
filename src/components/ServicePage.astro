---
// SEO/service landing template. Content per page; structure + Netlify form shared.
import Page from '../layouts/Page.astro';

interface Faq { q: string; a: string }
interface Props {
  title: string;
  description: string;
  path: string;
  serviceName: string;
  eyebrow: string;
  h1: string;
  lede: string;
  photo: string;
  photoAlt: string;
  sections: { heading: string; html: string }[];
  faqs: Faq[];
  related: { label: string; href: string }[];
  emergency?: boolean;
}
const { title, description, path, serviceName, eyebrow, h1, lede, photo, photoAlt, sections, faqs, related, emergency = false } = Astro.props;

const siteUrl = 'https://westlittlerockglass.com';
const phone = '501-223-3034';
const phoneTel = '+15012233034';

const serviceLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  serviceType: serviceName,
  areaServed: { '@type': 'City', name: 'Little Rock', containedInPlace: { '@type': 'State', name: 'Arkansas' } },
  provider: { '@type': 'LocalBusiness', name: 'West Little Rock Glass', telephone: phone, address: { '@type': 'PostalAddress', streetAddress: '1903 Hinson Loop Rd #3903', addressLocality: 'Little Rock', addressRegion: 'AR', postalCode: '72212' } },
  url: `${siteUrl}${path}`,
  ...(emergency ? { hoursAvailable: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], opens: '00:00', closes: '23:59' } } : {}),
});
const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---

<Page title={title} description={description} path={path} ldBlocks={[serviceLd, faqLd]}>
  <header class="lp-hero">
    <div class="container">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={`tel:${phoneTel}`}>{emergency ? `Call Now — ${phone}` : `Call ${phone}`}</a>
        <a class="btn btn-light" href="#quote">Get a Free Quote</a>
      </div>
    </div>
  </header>

  <section class="lp-section">
    <div class="container lp-grid">
      <div class="lp-body">
        <h2>{sections[0].heading}</h2>
        <Fragment set:html={sections[0].html} />
      </div>
      <div class="lp-photo">
        <img src={photo} alt={photoAlt} width="900" height="640" loading="eager" />
      </div>
    </div>
  </section>

  {sections.slice(1).map((s) => (
    <section class="lp-section alt">
      <div class="container">
        <div class="lp-body" style="max-width:70ch">
          <h2>{s.heading}</h2>
          <Fragment set:html={s.html} />
        </div>
      </div>
    </section>
  ))}

  <section class="lp-section">
    <div class="container lp-grid" style="align-items:start">
      <div class="lp-faq">
        <h2>Common questions</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <form id="quote" class="quote-form" name="quote" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <h3>Request a free quote</h3>
        <p>Tell us about your project. We respond within one business day{emergency ? ' — or call for immediate emergency service' : ''}.</p>
        <input type="hidden" name="form-name" value="quote" />
        <input type="hidden" name="page" value={path} />
        <p class="honeypot"><label>Don't fill this out: <input name="bot-field" /></label></p>
        <div class="form-row">
          <label>Name<input type="text" name="name" required autocomplete="name" /></label>
          <label>Phone<input type="tel" name="phone" required autocomplete="tel" /></label>
        </div>
        <div class="form-row">
          <label>Email<input type="email" name="email" autocomplete="email" /></label>
          <label>Project type<input type="text" name="project" placeholder={serviceName} /></label>
        </div>
        <label>Details<textarea name="details" rows="4" placeholder="Measurements, timing, anything else…"></textarea></label>
        <button class="btn btn-primary" type="submit">Send Quote Request</button>
      </form>
    </div>
  </section>

  <section class="lp-cta">
    <div class="container">
      <h2>{emergency ? 'Glass down? We answer 24/7.' : 'Free estimates. Straight answers. 20+ years of glass.'}</h2>
      <p>West Little Rock Glass — 1903 Hinson Loop Rd #3903, Little Rock. Family-run, local, and on time.</p>
      <div class="ctas">
        <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
        <a class="btn btn-ghost" style="color:var(--white);border-color:rgba(255,255,255,0.4)" href="/#services">All Services</a>
      </div>
    </div>
  </section>

  <div class="container">
    <nav class="lp-related" aria-label="Related services">
      <span>More from West Little Rock Glass:</span>
      {related.map((r) => <a href={r.href}>{r.label}</a>)}
    </nav>
  </div>
</Page>
