---
import Logo from '../components/Logo.astro';
const siteUrl = 'https://westlittlerockglass.com';
const title = 'West Little Rock Glass — Frameless Showers, Mirrors & 24-Hour Glass Repair | Little Rock, AR';
const description = 'Custom glass installation and 24-hour emergency repair in Little Rock, AR. 20+ years of frameless showers, mirrors, handrails, storefronts, and glass antiquing. Free estimates.';
const phone = '501-223-3034';
const phoneTel = '+15012233034';
const email = 'westlrglass@sbcglobal.net';

// Google Business Profile (place cid from GBP) — reviews link + NAP source of truth
const gbpUrl = 'https://www.google.com/maps?cid=17716891389159432705';
const aggregate = { ratingValue: 3.9, reviewCount: 38 };

// Real Google reviews, verbatim — verified 2026-07-04. Two realtors + a clinic operator = B2B trust.
const reviews = [
  { author: 'Chase Steppig', role: 'Repeat client · medical clinics', text: 'I have known Gavin for several years. He has done nothing but exceptional work for me personally and my clinics. Gavin and West Little Rock Glass should be your first and only call.' },
  { author: 'Brandy Harp', role: 'Realtor', text: 'Gavin and his team take exceptional care of our clients. They work hard to take care of windows, glass and mirrors for many homes that my company sells. Grateful for their customer service, care and kindness.' },
  { author: 'Chuck Manning', role: 'Custom shower', text: 'Gavin and the team did a wonderful job finishing our brand new custom shower with an incredible custom glass door! It is outstanding! We could not be happier — a beautiful addition to our home.' },
  { author: 'Timothy King', role: 'Realty Brokers AR', text: 'A lawnmower threw a rock and shattered my glass back door. West Little Rock Glass fixed it. Looks new again.' },
  { author: 'Rahul Patel', role: 'Commercial door repair', text: 'Replaced a pivot and hinge on a commercial door for me. Estimate on Friday, repair the following Tuesday. Can’t beat that. They’ll be my first call for future repairs.' },
  { author: 'Monica Freeman', role: 'Homeowner', text: 'Gavin at West Little Rock Glass is amazing. The whole crew is super nice and true professionals.' },
];

const reviewLd = reviews.slice(0, 4).map((r) => ({
  '@type': 'Review',
  reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
  author: { '@type': 'Person', name: r.author },
  reviewBody: r.text,
}));

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': siteUrl,
  name: 'West Little Rock Glass',
  image: `${siteUrl}/hero-handrails.jpeg`,
  description,
  telephone: phone,
  email,
  url: siteUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1903 Hinson Loop Rd #3903',
    addressLocality: 'Little Rock',
    addressRegion: 'AR',
    postalCode: '72212',
    addressCountry: 'US',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '17:00',
    },
  ],
  areaServed: [
    { '@type': 'City', name: 'Little Rock' },
    { '@type': 'AdministrativeArea', name: 'Arkansas' },
  ],
  priceRange: '$$',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: aggregate.ratingValue, reviewCount: aggregate.reviewCount, bestRating: 5 },
  review: reviewLd,
  sameAs: [gbpUrl],
  hasMap: gbpUrl,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Glass Services',
    itemListElement: [
      { '@type': 'Service', name: 'Frameless Shower Doors and Enclosures' },
      { '@type': 'Service', name: 'Custom Mirrors' },
      { '@type': 'Service', name: 'Glass Antiquing' },
      { '@type': 'Service', name: 'Handrails and Glass Railings' },
      { '@type': 'Service', name: 'Commercial Storefronts' },
      { '@type': 'Service', name: 'Custom Glass and Tabletops' },
      { '@type': 'Service', name: '24-Hour Emergency Glass Repair' },
    ],
  },
};

// Line-art glass icons (white stroke, sit in a badge over each card photo)
const ic = {
  shower: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5v3"/><path d="M5 10.5a7 7 0 0 1 14 0z"/><path d="M8 14v1.6M12 14.6v1.6M16 14v1.6M10 18v1.4M14 18v1.4"/></svg>',
  mirror: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="9.5" rx="6" ry="7"/><path d="M12 16.5v3M8.5 19.5h7"/><path d="M9.3 6.4c.9-1 2-1.4 3.2-1.2"/></svg>',
  antique: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h12l3.5 5.5L12 21 2.5 9.5z"/><path d="M2.5 9.5h19M9 4l-2.5 5.5L12 21M15 4l2.5 5.5"/></svg>',
  rail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 19h18"/><path d="M4 6v13M20 6v13M9 6v13M15 6v13"/></svg>',
  store: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8l1.3-3h14.4l1.3 3"/><path d="M3.5 8c.7 1.4 2.13 1.4 2.83 0s2.13 1.4 2.83 0 2.13 1.4 2.83 0 2.13 1.4 2.83 0 2.13 1.4 2.83 0 2.13 1.4 2.83 0"/><path d="M5 8.7V20h14V8.7"/><path d="M5 20h14M12 10.5V19.5"/><path d="M10.6 13.7v2M13.4 13.7v2"/><path d="M7.6 12.4l-1.3 4.2M16.8 12.1l-1.4 4.6"/></svg>',
  table: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h18l-1.4 3H4.4z"/><path d="M6 11v9M18 11v9"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.4 2"/></svg>',
  house: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M9.4 14.5l2 2 3.4-3.5"/></svg>',
};
const services = [
  { href: '/frameless-shower-doors-little-rock', img: '/work-shower-3.jpeg', icon: ic.shower, title: 'Frameless Showers', copy: 'Heavy-glass shower doors, walls, and enclosures. Custom-fit to any bathroom — no visible hardware between you and the view.' },
  { href: '/custom-mirrors-little-rock', img: '/service-mirror-install.jpeg', icon: ic.mirror, title: 'Custom Mirrors', copy: 'Bathroom vanity mirrors, wardrobe walls, gym walls, and custom cuts. Measured, cut, and installed to the quarter-inch.' },
  { href: '/custom-mirrors-little-rock', img: '/service-antiquing.jpeg', icon: ic.antique, title: 'Glass Antiquing', copy: 'Mirror walls with character — aged, distressed, and patina finishes that look decades old. A premium signature service.' },
  { href: '/glass-handrails-little-rock', img: '/work-glass-stairs.jpeg', icon: ic.rail, title: 'Handrails & Railings', copy: 'Interior staircases, deck edges, lake-house lookouts. Tempered glass panels on steel or wood, code-compliant and clean.' },
  { href: '/storefront-glass-little-rock', img: '/service-storefronts.jpeg', icon: ic.store, title: 'Commercial Storefronts', copy: 'Office fronts, retail entries, and double-pane window systems. Tempered, ADA-compliant, and built to code.' },
  { href: '/#quote', img: '/work-glass-table.jpeg', icon: ic.table, title: 'Custom Glass & Tabletops', copy: 'One-off panels, tabletops, shelves, and backsplashes. If you can draw it, we can cut it — up to 1" thick.' },
  { href: '/glass-repair-little-rock', img: '/service-install-crew.jpeg', icon: ic.clock, title: '24-Hour Emergency Repair', copy: 'Broken storefront? Shattered shower? Call day or night — we board up same-day and replace same-week.' },
  { href: '/#quote', img: '/service-antiquing-room.jpeg', icon: ic.house, title: 'Free In-Home Estimates', copy: 'We come out, measure, and give you a real number — not a range. No pressure, no subcontractors, no surprises.' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={siteUrl} />
<meta property="og:image" content={`${siteUrl}/hero-handrails.jpeg`} />
<meta property="og:site_name" content="West Little Rock Glass" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${siteUrl}/hero-handrails.jpeg`} />
<link rel="canonical" href={siteUrl} />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />

<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script>

<style>
:root{
  --navy:#12304F;
  --navy-dk:#0A1E33;
  --glass:#4A90B8;
  --sky:#A8C8DF;
  --sky-lt:#DCE9F3;
  --pearl:#F5F7FA;
  --white:#FFFFFF;
  --ink:#1A2332;
  --steel:#5F6B7A;
  --steel-lt:#9AA5B4;
  --amber:#D4922B;
  --amber-dk:#B8791A;
  --border:rgba(18,48,79,0.12);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Inter',system-ui,sans-serif;background:var(--white);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:clip}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
.container{max-width:1200px;margin:0 auto;padding:0 24px}
.heading{font-family:'Manrope',sans-serif;font-weight:700;letter-spacing:-0.015em;line-height:1.2}
.eyebrow{font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--glass);margin-bottom:0.75rem;display:inline-block}
.btn{display:inline-flex;align-items:center;gap:8px;padding:14px 26px;font-family:'Inter',sans-serif;font-weight:600;font-size:0.95rem;border-radius:4px;transition:all 0.2s;border:none;cursor:pointer;white-space:nowrap}
.btn-primary{background:var(--navy);color:var(--white)}
.btn-primary:hover{background:var(--navy-dk);transform:translateY(-1px)}
.btn-amber{background:var(--amber);color:var(--white)}
.btn-amber:hover{background:var(--amber-dk);transform:translateY(-1px)}
.btn-ghost{background:var(--white);color:var(--navy);border:1.5px solid var(--navy)}
.btn-ghost:hover{background:var(--navy);color:var(--white)}
.btn-outline-white{background:transparent;color:var(--white);border:1.5px solid var(--white)}
.btn-outline-white:hover{background:var(--white);color:var(--navy)}

/* TOP BAR */
.topbar{background:var(--navy-dk);color:var(--sky);font-size:0.85rem;padding:8px 0}
.topbar-inner{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.topbar a{color:var(--white);font-weight:600;transition:color 0.2s}
.topbar a:hover{color:var(--sky)}
.topbar-items{display:flex;gap:24px;flex-wrap:wrap;align-items:center}
.topbar-item{display:inline-flex;align-items:center;gap:6px}

/* NAV */
.nav{position:sticky;top:0;z-index:100;background:var(--white);border-bottom:1px solid var(--border);box-shadow:0 1px 3px rgba(18,48,79,0.04)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;max-width:1200px;margin:0 auto;gap:24px}
.nav-logo{display:flex;align-items:center;line-height:1.1}
.nav-logo img{height:38px;width:auto;display:block}
@media(max-width:600px){.nav-logo img{height:32px}}
.nav-menu{display:flex;gap:28px;align-items:center}
.nav-menu a:not(.btn){font-size:0.93rem;font-weight:500;color:var(--ink);transition:color 0.2s}
.nav-menu a:not(.btn):hover{color:var(--glass)}
.nav-menu .btn{padding:10px 20px;font-size:0.88rem}

/* HERO */
.hero{position:relative;min-height:640px;display:flex;align-items:center;overflow:hidden;background:var(--navy-dk)}
/* diagonal "slash" where the hero meets the page */
.hero::after{content:'';position:absolute;left:0;right:0;bottom:0;height:clamp(46px,6.5vw,92px);background:var(--pearl);z-index:2;clip-path:polygon(0 100%,100% 0,100% 100%)}
.hero-bg{position:absolute;inset:0;z-index:0}
.hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center}
.hero-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,30,51,0.82) 0%,rgba(18,48,79,0.55) 60%,rgba(74,144,184,0.25) 100%)}
.hero-inner{position:relative;z-index:4;padding:80px 0;width:100%}
.hero h1{font-family:'Manrope',sans-serif;font-size:clamp(2rem,5vw,3.5rem);font-weight:800;line-height:1.1;color:var(--white);letter-spacing:-0.02em;margin-bottom:1.5rem;max-width:780px}
.hero h1 span{color:var(--sky)}
.hero-sub{font-size:1.15rem;line-height:1.6;color:rgba(255,255,255,0.9);margin-bottom:2rem;max-width:620px}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap}
.hero-eyebrow{font-size:13px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:var(--sky);margin-bottom:1rem;display:inline-block}

/* HERO — content entrance only (fade-up on load, no ongoing motion) */
.hero-rise{opacity:0;transform:translateY(16px);animation:heroRise 0.75s cubic-bezier(0.22,0.61,0.36,1) forwards}
.hero-rise.d1{animation-delay:0.05s}
.hero-rise.d2{animation-delay:0.16s}
.hero-rise.d3{animation-delay:0.28s}
.hero-rise.d4{animation-delay:0.40s}
@keyframes heroRise{to{opacity:1;transform:translateY(0)}}

/* TRUST BAR */
.trust{background:var(--pearl);padding:36px 0;border-bottom:1px solid var(--border)}
.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.trust-item{text-align:center;padding:8px}
.trust-stat{font-family:'Manrope',sans-serif;font-size:1.75rem;font-weight:800;color:var(--navy);line-height:1;margin-bottom:6px;letter-spacing:-0.02em}
.trust-label{font-size:0.82rem;color:var(--steel);font-weight:500;line-height:1.4}

/* SECTION COMMON */
section{padding:90px 0}
.section-header{text-align:center;max-width:720px;margin:0 auto 3.5rem}
.section-header h2{font-size:clamp(1.7rem,3.5vw,2.5rem);color:var(--ink);margin-bottom:1rem}
.section-header p{font-size:1.08rem;color:var(--steel);line-height:1.65}

/* SERVICES */
.services{background:var(--white)}
.services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.service-card{display:flex;flex-direction:column;background:var(--white);border:1px solid var(--border);border-radius:8px;overflow:hidden;transition:transform 0.25s,box-shadow 0.25s,border-color 0.25s;cursor:pointer;color:inherit}
.service-card:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(18,48,79,0.1);border-color:var(--glass)}
.service-card:hover h3{color:var(--glass)}
.service-card:focus-visible{outline:2px solid var(--glass);outline-offset:2px}
.service-img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.service-body{padding:20px;flex:1;display:flex;flex-direction:column}
.service-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:16px}
.service-more{font-family:'Manrope',sans-serif;font-size:0.82rem;font-weight:700;color:var(--glass);letter-spacing:0.01em}
.service-icon{flex:none;width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:var(--glass);border-radius:9px;background:rgba(74,144,184,0.1);transition:background 0.25s,color 0.25s}
.service-icon svg{width:22px;height:22px}
.service-card:hover .service-icon{background:var(--glass);color:#fff}
.service-body h3{font-family:'Manrope',sans-serif;font-size:1.05rem;font-weight:700;color:var(--navy);margin-bottom:8px;letter-spacing:-0.01em}
.service-body p{font-size:0.9rem;color:var(--steel);line-height:1.55}
/* glass glint sweep on hover — echoes the hero motif */
.service-card{position:relative}
.service-card::after{content:'';position:absolute;inset:0;z-index:3;pointer-events:none;
  background:linear-gradient(105deg,transparent 38%,rgba(255,255,255,0.38) 50%,transparent 62%);
  transform:translateX(-110%);opacity:0}
.service-card:hover::after{animation:cardGlint 0.85s ease-out}
@keyframes cardGlint{0%{transform:translateX(-110%);opacity:0}12%{opacity:1}100%{transform:translateX(110%);opacity:0}}

/* GALLERY */
.gallery{background:var(--pearl)}
.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.gallery-img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:8px;box-shadow:0 4px 12px rgba(18,48,79,0.06)}

/* TESTIMONIAL */
.testimonial{background:var(--navy)}
.testimonial-inner{max-width:780px;margin:0 auto;text-align:center;color:var(--white)}
.testimonial-mark{font-family:'Manrope',serif;font-size:4rem;color:var(--sky);line-height:0.5;opacity:0.6;margin-bottom:1rem;display:block}
.testimonial-quote{font-size:clamp(1.15rem,2vw,1.4rem);font-style:italic;line-height:1.6;color:var(--white);margin-bottom:2rem}
.testimonial-quote strong{font-style:normal;font-weight:600;color:var(--sky)}
.testimonial-author{font-weight:600;color:var(--sky);letter-spacing:0.05em;text-transform:uppercase;font-size:0.88rem}
.testimonial-author span{display:block;font-weight:400;color:rgba(168,200,223,0.6);text-transform:none;letter-spacing:0;font-size:0.82rem;margin-top:4px}

/* ABOUT */
.about{background:var(--white)}
.about-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:center}
.about h2{font-size:clamp(1.7rem,3.3vw,2.3rem);margin-bottom:1.25rem;color:var(--ink)}
.about p{font-size:1.03rem;line-height:1.75;color:var(--steel);margin-bottom:1.15rem}
.about p strong{color:var(--ink);font-weight:600}
.about-img{width:100%;height:auto;border-radius:8px;box-shadow:0 12px 40px rgba(18,48,79,0.15)}
.about-quote{font-size:1.12rem;line-height:1.6;font-style:italic;color:var(--navy);border-left:3px solid var(--amber);padding-left:18px;margin-top:1.5rem}
.about-quote span{display:block;font-style:normal;font-size:0.85rem;color:var(--steel);margin-top:8px;font-weight:600}
.about-quote a{color:var(--glass)}

/* CONTACT */
.contact{background:var(--pearl)}
.contact-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:50px;align-items:start}
.contact-info h3{font-family:'Manrope',sans-serif;font-size:1.25rem;font-weight:700;color:var(--navy);margin-bottom:8px;letter-spacing:-0.01em}
.contact-block{background:var(--white);padding:28px;border:1px solid var(--border);border-radius:8px;margin-bottom:16px}
.contact-block a{color:var(--glass);font-weight:600;transition:color 0.2s}
.contact-block a:hover{color:var(--navy)}
.contact-phone{font-family:'Manrope',sans-serif;font-size:2rem;font-weight:800;color:var(--navy);letter-spacing:-0.02em;display:block;margin:4px 0 10px;line-height:1}
.contact-phone:hover{color:var(--glass)}
.contact-small{font-size:0.88rem;color:var(--steel);line-height:1.6}
.contact-emergency{background:var(--amber);color:var(--white);padding:16px 20px;border-radius:6px;margin-top:10px;font-weight:600;display:flex;align-items:center;gap:10px;font-size:0.93rem}
.contact-emergency strong{font-weight:800}

/* FORM */
.quote-form{background:var(--white);padding:32px;border:1px solid var(--border);border-radius:8px}
.quote-form h3{font-family:'Manrope',sans-serif;font-size:1.35rem;font-weight:700;color:var(--navy);margin-bottom:0.5rem}
.quote-form > p{color:var(--steel);margin-bottom:1.5rem;font-size:0.95rem}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.form-field{display:flex;flex-direction:column;gap:4px;margin-bottom:12px}
.form-field label{font-size:0.82rem;color:var(--ink);font-weight:600}
.form-field input,.form-field textarea,.form-field select{background:var(--white);border:1.5px solid var(--border);border-radius:4px;padding:11px 13px;color:var(--ink);font-family:'Inter',sans-serif;font-size:0.95rem;transition:border-color 0.2s}
.form-field input:focus,.form-field textarea:focus,.form-field select:focus{outline:none;border-color:var(--glass)}
.form-field textarea{resize:vertical;min-height:90px}
.honeypot{display:none}

/* FOOTER */
.footer{background:var(--navy-dk);color:var(--sky);padding:48px 0 24px}
.footer-grid{display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr;gap:40px;margin-bottom:32px}
.footer-brand{font-family:'Manrope',sans-serif;font-weight:800;font-size:1.15rem;color:var(--white);margin-bottom:12px;letter-spacing:-0.01em}
.footer-brand + p{font-size:0.9rem;line-height:1.6;color:rgba(168,200,223,0.8);max-width:360px}
.footer-col h4{font-family:'Manrope',sans-serif;font-size:0.88rem;font-weight:700;color:var(--white);margin-bottom:12px;text-transform:uppercase;letter-spacing:0.1em}
.footer-col a,.footer-col p{display:block;color:rgba(168,200,223,0.8);font-size:0.9rem;padding:4px 0;transition:color 0.2s;line-height:1.5}
.footer-col a:hover{color:var(--white)}
.footer-bottom{border-top:1px solid rgba(168,200,223,0.15);padding-top:20px;display:flex;justify-content:space-between;font-size:0.82rem;color:rgba(168,200,223,0.6);flex-wrap:wrap;gap:10px}

/* PRESS BAR */
.press{background:var(--navy);border-top:1px solid rgba(255,255,255,0.07);border-bottom:1px solid rgba(255,255,255,0.07);padding:22px 0}
.press-inner{display:flex;align-items:center;justify-content:center;gap:14px 40px;flex-wrap:wrap;text-align:center}
.press-label{font-family:'Manrope',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.48)}
.press-logo{display:block;width:auto;opacity:0.9;transition:opacity .2s}
.press-logo:hover{opacity:1}
.press-logo--ay{height:23px}
.press-logo--athome{height:29px}

/* REVIEWS */
.reviews{background:var(--pearl)}
.reviews-rating{display:flex;align-items:center;justify-content:center;gap:10px;margin:0 auto;flex-wrap:wrap}
.reviews-rating .num{font-family:'Manrope',sans-serif;font-weight:800;font-size:1.15rem;color:var(--navy)}
.stars{color:var(--amber);letter-spacing:2px;font-size:1.05rem}
.reviews-rating .count{color:var(--steel);font-size:0.9rem}
.reviews-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(288px,1fr));gap:18px;margin-top:2.6rem}
.review-card{background:var(--white);border:1px solid var(--border);border-radius:10px;padding:24px;display:flex;flex-direction:column;gap:12px;box-shadow:0 4px 14px rgba(18,48,79,0.05)}
.review-card .rc-stars{color:var(--amber);font-size:0.9rem;letter-spacing:1px}
.review-card p{color:var(--ink);font-size:0.96rem;line-height:1.62;flex:1}
.review-card .rc-author{font-family:'Manrope',sans-serif;font-weight:700;color:var(--navy);font-size:0.95rem}
.review-card .rc-role{font-size:0.78rem;color:var(--steel);margin-top:2px;text-transform:uppercase;letter-spacing:0.06em}
.reviews-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:2.6rem;align-items:center}
.reviews-cta .rc-note{font-size:0.85rem;color:var(--steel);width:100%;text-align:center;margin-top:4px}

/* COMMUNITY */
.community{background:var(--navy);color:var(--white)}
.community .section-header h2{color:var(--white)}
.community .section-header p{color:var(--sky)}
.community-badges{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:0.5rem}
.community-badge{background:rgba(255,255,255,0.05);border:1px solid rgba(168,200,223,0.22);border-radius:8px;padding:14px 22px;font-family:'Manrope',sans-serif;font-weight:700;color:var(--white);font-size:0.98rem;text-align:center}
.community-badge span{display:block;font-family:'Inter',sans-serif;font-weight:400;font-size:0.8rem;color:var(--sky);margin-top:4px}

/* RES / COMMERCIAL SPLIT */
.split{background:var(--white)}
.split-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.split-card{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:12px;overflow:hidden;background:var(--white);transition:transform .25s,box-shadow .25s,border-color .25s;color:inherit}
.split-card:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(18,48,79,.12);border-color:var(--glass)}
.split-card:focus-visible{outline:2px solid var(--glass);outline-offset:3px}
.split-img{height:210px;background-size:cover;background-position:center}
.split-body{padding:26px 28px 30px}
.split-tag{display:inline-block;font-family:'Manrope',sans-serif;font-size:.7rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--glass);margin-bottom:8px}
.split-body h3{font-family:'Manrope',sans-serif;font-size:1.4rem;font-weight:800;color:var(--navy);margin-bottom:14px;letter-spacing:-.01em}
.split-body ul{list-style:none;display:grid;gap:8px;margin-bottom:18px}
.split-body li{padding-left:24px;position:relative;color:var(--steel);font-size:.94rem}
.split-body li::before{content:'';position:absolute;left:2px;top:.5em;width:7px;height:7px;border:1.5px solid var(--glass);border-radius:1px;transform:rotate(45deg)}
.split-link{font-family:'Manrope',sans-serif;font-weight:700;color:var(--glass);font-size:.92rem}
.split-card:hover .split-link{color:var(--navy)}

/* RESPONSIVE */
@media(max-width:960px){
  .split-grid{grid-template-columns:1fr}
  .services-grid{grid-template-columns:repeat(2,1fr)}
  .trust-grid{grid-template-columns:repeat(2,1fr);gap:20px}
  .about-grid{grid-template-columns:1fr;gap:40px}
  .contact-grid{grid-template-columns:1fr;gap:24px}
  .footer-grid{grid-template-columns:1fr 1fr}
  .nav-menu a:not(.btn){display:none}
  .hero{min-height:520px}
  section{padding:60px 0}
  .topbar-items{justify-content:center}
}
@media(max-width:600px){
  .services-grid{grid-template-columns:1fr}
  .gallery-grid{grid-template-columns:repeat(2,1fr)}
  .form-row{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr}
  .footer-bottom{flex-direction:column;text-align:center}
  /* hero on phones: size to content, tame the diagonal, stack CTAs */
  .hero{min-height:auto}
  .hero-inner{padding:52px 0 40px}
  .hero h1{font-size:1.85rem;margin-bottom:1rem}
  .hero-sub{font-size:1rem;margin-bottom:1.5rem}
  .hero::after{height:34px}
  .hero-ctas{flex-direction:column;align-items:stretch}
  .hero-ctas .btn{width:100%;justify-content:center}
}
@media(prefers-reduced-motion:reduce){
  .hero-rise{opacity:1;transform:none;animation:none}
  .service-card:hover::after{animation:none}
}
</style>
</head>
<body>

<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-items">
      <span class="topbar-item">&#128205; 1903 Hinson Loop Rd #3903, Little Rock, AR</span>
      <span class="topbar-item">&#128337; Mon&ndash;Fri 8am&ndash;5pm &middot; 24/7 Emergency</span>
    </div>
    <div class="topbar-items">
      <a href={`tel:${phoneTel}`} class="topbar-item">&#9742; {phone}</a>
    </div>
  </div>
</div>

<nav class="nav">
  <div class="nav-inner">
    <Logo href="#top" />
    <div class="nav-menu">
      <a href="#services">Services</a>
      <a href="#gallery">Gallery</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
      <a href="#quote" class="btn btn-primary">Free Quote</a>
    </div>
  </div>
</nav>

<section class="hero" id="top">
  <div class="hero-bg"><img src="/hero-handrails.jpeg" alt="Multi-level glass handrails installation on a Little Rock lake house by West Little Rock Glass" /></div>
  <div class="hero-inner">
    <div class="container">
      <span class="hero-eyebrow hero-rise d1">20+ Years in Little Rock &middot; Locally Owned</span>
      <h1 class="hero-rise d2">Custom glass. <span>24-hour repair.</span><br />Installed right, the first time.</h1>
      <p class="hero-sub hero-rise d3">Frameless showers, mirrors, handrails, storefronts, and emergency repair across the Little Rock metro. One local crew &mdash; from first quote to final clean-up.</p>
      <div class="hero-ctas hero-rise d4">
        <a href={`tel:${phoneTel}`} class="btn btn-amber">&#9742; Call {phone}</a>
        <a href="#quote" class="btn btn-outline-white">Get a free quote</a>
      </div>
    </div>
  </div>
</section>

<section class="trust">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-item">
        <div class="trust-stat">20+</div>
        <div class="trust-label">Years in business</div>
      </div>
      <div class="trust-item">
        <div class="trust-stat">24/7</div>
        <div class="trust-label">Emergency glass repair</div>
      </div>
      <div class="trust-item">
        <div class="trust-stat">Free</div>
        <div class="trust-label">In-home estimates</div>
      </div>
      <div class="trust-item">
        <div class="trust-stat">Local</div>
        <div class="trust-label">Little Rock owned &amp; operated</div>
      </div>
    </div>
  </div>
</section>

<section class="press">
  <div class="container">
    <div class="press-inner">
      <span class="press-label">As featured in</span>
      <a href="https://aymag.com/building-product-homeowners/" target="_blank" rel="noopener" aria-label="Featured in AY About You magazine">
        <img class="press-logo press-logo--ay" src="/press-ay.webp" alt="AY About You" width="700" height="80" loading="lazy" />
      </a>
      <a href="https://www.athomearkansas.com/article/historical-influence/" target="_blank" rel="noopener" aria-label="Featured in At Home in Arkansas magazine">
        <img class="press-logo press-logo--athome" src="/press-athome-white.png" alt="At Home in Arkansas" width="213" height="56" loading="lazy" />
      </a>
    </div>
  </div>
</section>

<section id="services" class="services">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">What we install</span>
      <h2 class="heading">Every kind of glass, all from one crew.</h2>
      <p>No subcontractors, no sales reps. The people who quote your project are the people who install it.</p>
    </div>
    <div class="services-grid">
      {services.map((s) => (
        <a class="service-card" href={s.href}>
          <img src={s.img} alt={`${s.title} by West Little Rock Glass`} class="service-img" loading="lazy" />
          <div class="service-body">
            <h3>{s.title}</h3>
            <p>{s.copy}</p>
            <div class="service-foot">
              <span class="service-more">Learn more &rarr;</span>
              <span class="service-icon" aria-hidden="true" set:html={s.icon} />
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="split">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Homeowner or business?</span>
      <h2 class="heading">Glass for your home &mdash; or your storefront.</h2>
      <p>Two sides of the same 20-year shop. Pick the one that fits and see exactly what we do.</p>
    </div>
    <div class="split-grid">
      <a class="split-card" href="/residential-glass-little-rock">
        <div class="split-img" style="background-image:url('/work-shower-1.jpeg')"></div>
        <div class="split-body">
          <span class="split-tag">Residential</span>
          <h3>For your home</h3>
          <ul>
            <li>Frameless shower doors &amp; enclosures</li>
            <li>Custom mirrors &amp; glass antiquing</li>
            <li>Glass handrails, tabletops &amp; shelves</li>
            <li>Foggy or cracked window replacement</li>
          </ul>
          <span class="split-link">Residential glass &amp; FAQ &rarr;</span>
        </div>
      </a>
      <a class="split-card" href="/commercial-glass-little-rock">
        <div class="split-img" style="background-image:url('/service-storefronts.jpeg')"></div>
        <div class="split-body">
          <span class="split-tag">Commercial</span>
          <h3>For your business</h3>
          <ul>
            <li>Storefronts, entries &amp; door glass</li>
            <li>Office partitions &amp; insulated units</li>
            <li>Code-compliant, tempered &amp; ADA glazing</li>
            <li>24-hour emergency repair &amp; board-up</li>
          </ul>
          <span class="split-link">Commercial glass &amp; FAQ &rarr;</span>
        </div>
      </a>
    </div>
  </div>
</section>

<section id="gallery" class="gallery">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Recent work</span>
      <h2 class="heading">Twenty years of Little Rock installs.</h2>
      <p>A sample of projects across residential, commercial, and hospitality.</p>
    </div>
    <div class="gallery-grid">
      <img src="/work-glass-stairs.jpeg" alt="Custom glass staircase railing and landing balustrade in a Little Rock home by West Little Rock Glass" class="gallery-img" loading="lazy" />
      <img src="/work-shower-1.jpeg" alt="Glass shower and tub enclosure over marble tile by West Little Rock Glass" class="gallery-img" loading="lazy" />
      <img src="/work-glass-table.jpeg" alt="Custom cut-glass top on a live-edge wood table by West Little Rock Glass" class="gallery-img" loading="lazy" />
      <img src="/work-shower-2.jpeg" alt="Custom glass shower enclosure in a Little Rock bathroom by West Little Rock Glass" class="gallery-img" loading="lazy" />
      <img src="/work-shower-3.jpeg" alt="Glass shower door and enclosure by West Little Rock Glass" class="gallery-img" loading="lazy" />
      <img src="/service-storefronts.jpeg" alt="Commercial glass storefront by West Little Rock Glass" class="gallery-img" loading="lazy" />
    </div>
  </div>
</section>

<section id="reviews" class="reviews">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Reviewed by neighbors, realtors &amp; local businesses</span>
      <h2 class="heading">The people who sell and run Little Rock buildings call us first.</h2>
      <div class="reviews-rating">
        <span class="stars">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
        <span class="num">{aggregate.ratingValue}</span>
        <span class="count">&middot; {aggregate.reviewCount} Google reviews</span>
      </div>
    </div>
    <div class="reviews-grid">
      {reviews.map((r) => (
        <blockquote class="review-card">
          <span class="rc-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <p>{r.text}</p>
          <div>
            <div class="rc-author">{r.author}</div>
            <div class="rc-role">{r.role}</div>
          </div>
        </blockquote>
      ))}
    </div>
    <div class="reviews-cta">
      <a href={gbpUrl} target="_blank" rel="noopener" class="btn btn-primary">Read all {aggregate.reviewCount} reviews on Google &rarr;</a>
      <a href={gbpUrl} target="_blank" rel="noopener" class="btn btn-ghost">Leave a review</a>
    </div>
  </div>
</section>

<section id="about" class="about">
  <div class="container">
    <div class="about-grid">
      <div>
        <span class="eyebrow">About WLRG</span>
        <h2 class="heading">Same faces, same phone number, same truck for two decades.</h2>
        <p>West Little Rock Glass has been cutting, shaping, and installing glass in Little Rock for more than twenty years. We&rsquo;re a small local crew &mdash; no subcontractors, no high-pressure sales reps, no out-of-state call center.</p>
        <p><strong>Every project is quoted, installed, and backed by the same people.</strong> Owner <b>Gavin Higgins</b> and the crew have spent years in the trade, and it shows: the details matter, the clean-up is part of the job, and the phone still rings at 501-223-3034 long after the install is done.</p>
        <p>Whether it&rsquo;s a master-bath frameless shower, a lake-house handrail run, an antique mirror backsplash, or the outdoor dining glass at <b>Cache in the River Market</b>, we do the work ourselves. That&rsquo;s the entire business model.</p>
        <p class="about-quote">&ldquo;We can make that look you are dreaming about in your head. Our aim is to look good on you.&rdquo;<span>&mdash; Gavin Higgins, owner &middot; featured in <a href="https://aymag.com/building-product-homeowners/" target="_blank" rel="noopener">AY About You</a></span></p>
        <div class="hero-ctas" style="margin-top:1.5rem">
          <a href={`tel:${phoneTel}`} class="btn btn-primary">&#9742; Call {phone}</a>
          <a href="#quote" class="btn btn-ghost">Request a quote</a>
        </div>
      </div>
      <div>
        <img src="/service-install-crew.jpeg" alt="West Little Rock Glass crew installing commercial storefront glass" class="about-img" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<section class="community">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow" style="color:var(--sky)">Rooted in the community</span>
      <h2 class="heading">Proud sponsor of Little Rock cycling.</h2>
      <p>Owner Gavin Higgins is an avid cyclist &mdash; and West Little Rock Glass puts its name behind the riders and races that make Central Arkansas move.</p>
    </div>
    <div class="community-badges">
      <div class="community-badge">Rock City Cycling<span>Women&rsquo;s team sponsor</span></div>
      <div class="community-badge">Arkansas United<span>Men&rsquo;s team sponsor</span></div>
      <div class="community-badge">Local Races<span>Season-long support</span></div>
    </div>
  </div>
</section>

<section id="contact" class="contact">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Get in touch</span>
      <h2 class="heading">Free quote, fast response.</h2>
      <p>Tell us what you need. We&rsquo;ll call back with a real number, not a range.</p>
    </div>
    <div class="contact-grid">
      <div class="contact-info">
        <div class="contact-block">
          <h3>Call or email</h3>
          <a href={`tel:${phoneTel}`} class="contact-phone">{phone}</a>
          <a href={`mailto:${email}`}>{email}</a>
        </div>
        <div class="contact-block">
          <h3>Shop location</h3>
          <p class="contact-small">1903 Hinson Loop Rd #3903<br />Little Rock, AR 72212</p>
        </div>
        <div class="contact-block">
          <h3>Hours</h3>
          <p class="contact-small">Monday&ndash;Friday &middot; 8am&ndash;5pm</p>
          <div class="contact-emergency">
            <span>&#9888;</span>
            <div><strong>24/7 Emergency Repair</strong><br />Call anytime &mdash; we board up same-day.</div>
          </div>
        </div>
      </div>
      <form id="quote" class="quote-form" name="quote" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <h3>Request a free quote</h3>
        <p>Tell us about your project. We respond within one business day.</p>
        <input type="hidden" name="form-name" value="quote" />
        <p class="honeypot"><label>Don't fill this out: <input name="bot-field" /></label></p>
        <div class="form-row">
          <div class="form-field">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" required />
          </div>
          <div class="form-field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" required />
          </div>
        </div>
        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-field">
          <label for="service">What do you need?</label>
          <select id="service" name="service">
            <option value="">Choose one…</option>
            <option value="Frameless shower">Frameless shower door or enclosure</option>
            <option value="Custom mirror">Custom mirror</option>
            <option value="Glass antiquing">Glass antiquing</option>
            <option value="Handrails">Glass handrails / railings</option>
            <option value="Storefront">Commercial storefront</option>
            <option value="Custom glass">Custom glass or tabletop</option>
            <option value="Emergency repair">24-hour emergency repair</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-field">
          <label for="message">Project details</label>
          <textarea id="message" name="message" rows="4" placeholder="Rough dimensions, location, timing — whatever you've got."></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Send request &rarr;</button>
      </form>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">West Little Rock Glass</div>
        <p>Custom glass installation and 24-hour emergency repair. Little Rock, Arkansas since 2005. No subcontractors — the crew that quotes it installs it.</p>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <a href="/frameless-shower-doors-little-rock">Frameless showers</a>
        <a href="/custom-mirrors-little-rock">Custom mirrors &amp; antiquing</a>
        <a href="/glass-handrails-little-rock">Handrails &amp; railings</a>
        <a href="/storefront-glass-little-rock">Commercial storefronts</a>
        <a href="/glass-repair-little-rock">24-hour glass repair</a>
        <a href="#services">All services</a>
      </div>
      <div class="footer-col">
        <h4>Service Area</h4>
        <a href="/glass-north-little-rock">North Little Rock</a>
        <a href="/glass-sherwood">Sherwood</a>
        <a href="/glass-jacksonville">Jacksonville</a>
        <a href="/glass-maumelle">Maumelle</a>
        <a href="/glass-cabot">Cabot</a>
        <a href="/glass-conway">Conway</a>
        <a href="/glass-benton">Benton</a>
        <a href="/glass-bryant">Bryant</a>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <a href={`tel:${phoneTel}`}>{phone}</a>
        <a href={`mailto:${email}`}>{email}</a>
        <p>1903 Hinson Loop Rd #3903<br />Little Rock, AR 72212</p>
      </div>
    </div>
    <div class="footer-bottom">
      <div>&copy; 2026 West Little Rock Glass. All rights reserved.</div>
      <div>Built with craft by <a href="https://bitbrd.com" target="_blank" rel="noopener" style="color:var(--sky);font-weight:600">BitBrd</a></div>
    </div>
  </div>
</footer>

</body>
</html>
